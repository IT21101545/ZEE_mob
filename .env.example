# Copy this file to ".env" in this folder (same level as package.json).
# Replace 192.168.1.100 with YOUR computer's Wi‑Fi IPv4 (Windows: ipconfig → "Wireless LAN adapter" → IPv4 Address).
# Do NOT use the literal text "your_pc_lan_ip" — Firefox cannot resolve that.

EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api
